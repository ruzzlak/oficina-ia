# ════════════════════════════════════════════════════════════════════
#  Oficina IA — configuración.  Copia a .env y rellena.  NO subas .env a git.
# ════════════════════════════════════════════════════════════════════

# ── Usuario dueño de ./data en el VPS (pon el resultado de `id -u` / `id -g`).
# Si entras como root (Hostinger y la mayoría de VPS), deja 10000: nunca 0.
HERMES_UID=10000
HERMES_GID=10000
TZ=America/New_York

# ── Modelos para los agentes Hermes ─────────────────────────────────
# Proveedor: auto | openrouter | anthropic | nous | openai | ...
# "auto" detecta según la clave que pongas abajo.
HERMES_PROVIDER=auto
# Manager (orquesta: conviene un modelo fuerte) y trabajadores (más baratos).
# Formato de id según el proveedor (OpenRouter: "anthropic/claude-...").
# Déjalos vacíos para gestionarlos tú con `./office.sh hermes model`.
HERMES_MODEL_MANAGER=
HERMES_MODEL_WORKERS=

# Claves (pon al menos una). Con ANTHROPIC_API_KEY los agentes Hermes
# también pueden usar Claude como modelo.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# NOUS_API_KEY=
# OPENAI_API_KEY=

# ── Claude Code ─────────────────────────────────────────────────────
# Usa ANTHROPIC_API_KEY (arriba), o deja vacío e inicia sesión con tu
# suscripción Claude (Pro/Max) con:  ./office.sh claude-login
# CLAUDE_CODE_OAUTH_TOKEN=
OFFICE_CLAUDE_MAX_TURNS=40
# OFFICE_CLAUDE_MODEL=

# ── Dashboard de Hermes (obligatorio: usuario y contraseña) ─────────
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=cambia-esta-contraseña
# Cadena aleatoria para que la sesión sobreviva reinicios: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# ── Obsidian web (obligatorio) ──────────────────────────────────────
OBSIDIAN_WEB_USER=oficina
OBSIDIAN_WEB_PASSWORD=cambia-esta-contraseña

# ── Puertos (solo en localhost del VPS por defecto) ─────────────────
BIND_ADDR=127.0.0.1
OFFICE_PORT=3100
DASHBOARD_PORT=9119
OBSIDIAN_PORT=3000

# ── (opcional) Acceso público con HTTPS:  ./office.sh up --public ───
# ACME_EMAIL=tu@correo.com
# OFFICE_DOMAIN=oficina.tudominio.com
# DASHBOARD_DOMAIN=hermes.tudominio.com
# VAULT_DOMAIN=vault.tudominio.com
# OFFICE_WEB_USER=oficina
# OFFICE_WEB_PASSWORD_HASH=      # ./office.sh hash-password
# HERMES_DASHBOARD_PUBLIC_URL=https://hermes.tudominio.com
# OFFICE_PUBLIC_URL=https://oficina.tudominio.com

# ── (opcional) Hablar con el Manager por Telegram ───────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=      # tu id numérico de Telegram

# ── Construcción de la imagen ───────────────────────────────────────
HERMES_IMAGE=nousresearch/hermes-agent:latest
# npm (paquete publicado) o git (compila github.com/pixel-agents-hq/pixel-agents)
PIXEL_AGENTS_SOURCE=npm
PIXEL_AGENTS_VERSION=latest
PIXEL_AGENTS_REF=v1.4.1
CLAUDE_CODE_VERSION=latest
